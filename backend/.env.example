# ─── Required ─────────────────────────────────────────────────────────────────

# Your Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Login credentials for the app — change these before deploying
APP_USERNAME=your_username
APP_PASSWORD=your_secure_password

# ─── Optional ─────────────────────────────────────────────────────────────────

# Hard spending cap in USD. Any request that would push total spend past this
# value is rejected with HTTP 402. Omit or set to 0 for no limit.
MAX_COST_USD=

# Frontend origin allowed by CORS (e.g. https://yourdomain.com).
# Omit or leave empty during local development — defaults to * with a warning.
ALLOWED_ORIGIN=

# Port to listen on (default: 8080)
PORT=8080

# Directory where history.json is stored (default: ./data)
# Make sure the process has write access to this path
DATA_DIR=data
